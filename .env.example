# Application
APP_NAME="TutorFlow API"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Security / Auth
SECRET_KEY=replace_with_a_secure_random_string_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_USER=tutorflow
POSTGRES_PASSWORD=tutorflow_dev_password
POSTGRES_DB=tutorflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg_async://tutorflow:tutorflow_dev_password@postgres:5432/tutorflow

# Redis / Celery
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# External AI Services
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email Providers
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=TutorFlow <notifications@tutorflow.dev>

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
BACKEND_PORT=8000